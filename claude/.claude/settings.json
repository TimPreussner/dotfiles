{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(*.env)",
      "Read(*local.properties)",
      "Read(*secrets.properties)"
    ],
    "ask": [
      "Bash(gh *)",
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git rebase)",
      "Bash(git rebase *)"
    ],
    "disableBypassPermissionsMode": "disable",
    "defaultMode": "default"
  },
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline.sh"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "localhost"
      ]
    },
    "excludedCommands": [
      "mvn"
    ]
  },
  "tui": "fullscreen"
}
